# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SERVE_FRONTEND=false
RUN_EMBEDDED_CONSUMER=false

# PostgreSQL (Local Docker or Cloud: Neon / Supabase / Render)
DATABASE_URL=postgresql://saas_user:saas_pass@localhost:5432/multitenant_saas
PG_POOL_MAX=20
PG_POOL_MIN=2
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_SSL=false

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# Kafka (Local Redpanda via Docker OR Cloud: Aiven / Upstash)
KAFKA_CLIENT_ID=multitenant-saas-platform
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_ORDERS=tenant.orders
KAFKA_CONSUMER_GROUP=order-processor-group
KAFKA_SSL=false
# Set for Upstash / Aiven SASL auth:
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Optional Base64-encoded CA cert for Aiven SSL if required:
KAFKA_CA_CERT_BASE64=

# Serverless Async Invoice Worker (Vercel deployed function URL; leave blank for local adapter)
SERVERLESS_INVOICE_URL=
