{
  "name": "multitenant-saas-platform",
  "version": "1.0.0",
  "private": true,
  "description": "CSC337 Lab 06: Multi-Tenant B2B SaaS Platform with Kafka Event-Driven Orders, PostgreSQL Performance Tuning, and Serverless Cold-Start Analysis",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:api": "npm --prefix backend run dev",
    "dev:worker": "npm --prefix backend run worker",
    "dev:web": "npm --prefix frontend run dev",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed",
    "benchmark:explain": "npm --prefix backend run benchmark:explain",
    "benchmark:n1": "npm --prefix backend run benchmark:n1",
    "benchmark:coldstart": "npm --prefix backend run benchmark:coldstart",
    "test": "npm --prefix backend test",
    "build:web": "npm --prefix frontend run build",
    "start": "npm --prefix backend start"
  }
}
